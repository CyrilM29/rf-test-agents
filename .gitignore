__pycache__/
*.pyc
.venv/
venv/

# Robot Framework outputs
results/
# rf-mcp session artifacts (created at the workspace root by the MCP server)
.robotmcp_artifacts/
log.html
report.html
output.xml

# Local editor state (committed team config would go to .vscode/settings.json explicitly)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/mcp.json

# Secrets, never commit credentials
*.secret
.env

# Local permission-hook policy chosen by the workstation owner
# (scripts/agent_policy.py on|off), never committed.
.claude/*.local.json

# Communication base: kept local, not published with the repo
comms/
