{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hook_agent_permissions.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hook_guards.py",
            "timeout": 30,
            "statusMessage": "Gardes spec-sync + conventions…"
          }
        ]
      }
    ]
  }
}
